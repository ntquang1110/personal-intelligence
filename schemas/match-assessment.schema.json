{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Intelligence Match Assessment",
  "type": "object",
  "required": ["schema_version", "assessment_id", "context", "purpose", "created_at", "participants", "criteria", "summary", "limitations", "human_decision_required"],
  "properties": {
    "schema_version": {"const": "2.2"},
    "assessment_id": {"type": "string", "minLength": 1},
    "context": {"enum": ["job", "partner", "marriage", "other"]},
    "purpose": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "participants": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["participant_id", "role_in_context", "opted_in", "approved_profile_ref"],
        "properties": {
          "participant_id": {"type": "string", "minLength": 1},
          "role_in_context": {"type": "string", "minLength": 1},
          "opted_in": {"const": true},
          "approved_profile_ref": {"type": "string", "minLength": 1},
          "correction_status": {"enum": ["not_requested", "pending", "reviewed", "corrections_requested"]}
        },
        "additionalProperties": false
      }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "name", "category", "importance_by_participant", "status", "evidence", "unknowns"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["values", "goals", "capability", "work_environment", "communication", "lifestyle", "family", "finance", "boundaries", "constraints", "other"]},
          "importance_by_participant": {"type": "object", "minProperties": 2, "additionalProperties": {"enum": ["must_have", "important", "preference", "exploratory"]}},
          "status": {"enum": ["aligned", "complementary", "unresolved", "conflicting", "not_applicable"]},
          "impact_if_unresolved": {"enum": ["low", "medium", "high", "unknown"]},
          "evidence": {
            "type": "array", "items": {
              "type": "object",
              "required": ["participant_id", "claim", "claim_type", "source_description", "confidence", "confidence_rationale"],
              "properties": {
                "participant_id": {"type": "string"},
                "claim": {"type": "string"},
                "claim_type": {"enum": ["observation", "self_report", "inference", "hypothesis", "validated", "unknown"]},
                "source_description": {"type": "string"},
                "source_reference": {"type": ["string", "null"]},
                "observed_at": {"type": ["string", "null"]},
                "confidence": {"enum": ["low", "medium", "high"]},
                "confidence_rationale": {"type": "string"},
                "counterevidence": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "interpretation": {"type": "string"},
          "alternative_explanations": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}},
          "questions_or_experiments": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["alignments", "complementary_differences", "conflicts", "high_impact_unknowns", "next_steps"],
      "properties": {
        "alignments": {"type": "array", "items": {"type": "string"}},
        "complementary_differences": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "high_impact_unknowns": {"type": "array", "items": {"type": "string"}},
        "next_steps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "correction_window": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "human_decision_required": {"const": true}
  },
  "additionalProperties": false
}
