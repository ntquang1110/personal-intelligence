{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purpose-Specific Shareable Profile",
  "type": "object",
  "required": ["schema_version", "profile_owner", "audience", "purpose", "created_at", "approved_fields", "claims", "limitations", "consent"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "profile_owner": {"type": "string", "minLength": 1},
    "audience": {"enum": ["employer", "recruiter", "potential_partner", "mutual_review", "other"]},
    "purpose": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "review_or_expiry_date": {"type": ["string", "null"]},
    "approved_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "claim_type", "evidence_summary", "approved_for_sharing"],
        "properties": {
          "field_id": {"type": "string"},
          "claim": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["demonstrated_evidence", "self_report", "hypothesis"]},
          "evidence_summary": {"type": "string"},
          "source_reference": {"type": ["string", "null"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "purpose_relevance": {"type": "string", "minLength": 1},
          "approved_for_sharing": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "consent": {
      "type": "object",
      "required": ["owner_approved", "recipient", "onward_sharing", "withdrawal_note"],
      "properties": {
        "owner_approved": {"const": true},
        "recipient": {"type": "string", "minLength": 1},
        "onward_sharing": {"enum": ["not_allowed", "ask_first", "allowed"]},
        "withdrawal_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
