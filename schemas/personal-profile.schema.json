{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Intelligence Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "claims",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "description",
          "availability"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "available",
              "partial",
              "unavailable"
            ]
          },
          "date_range": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
