{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "name",
          "evidence_level",
          "evidence",
          "confidence"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "exposure",
              "conceptual_understanding",
              "guided_execution",
              "independent_execution",
              "repeated_advanced_performance",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rubric": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_test": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
