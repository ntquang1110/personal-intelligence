{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-intelligence.local/schemas/human-map.schema.json",
  "title": "Personal Human Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "subject_ref",
    "created_at",
    "purpose",
    "evidence_inventory",
    "claims",
    "domains",
    "unknowns",
    "next_actions",
    "separation_policy",
    "assessment_synthesis"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "purpose": {
      "type": "string"
    },
    "evidence_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "source_type",
          "date_range",
          "limitations"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "self_report",
              "assessment",
              "interview",
              "behavioral_episode",
              "performance_task",
              "work_sample",
              "observer_feedback",
              "longitudinal_outcome",
              "interpretive_system"
            ]
          },
          "date_range": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "type": "string"
          },
          "consent_status": {
            "enum": [
              "authorized",
              "restricted",
              "unknown",
              "not_applicable"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "domain",
          "claim_class",
          "status",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "claim_class": {
            "enum": [
              "observation",
              "inference",
              "hypothesis",
              "validated",
              "unknown"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "supported_inference",
              "hypothesis",
              "unknown",
              "contradicted",
              "retired"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "low",
              "moderate",
              "high",
              "not_assessed"
            ]
          },
          "mechanism": {
            "type": [
              "string",
              "null"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "domains": {
      "type": "object",
      "required": [
        "context",
        "personality",
        "cognition",
        "motivation",
        "capabilities",
        "behavior",
        "environment_fit",
        "blind_spots",
        "development"
      ],
      "properties": {
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "personality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cognition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motivation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "behavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment_fit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blind_spots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "development": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "why_it_matters",
          "how_to_resolve"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "how_to_resolve": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "linked_claim_ids",
          "measure_of_success"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "linked_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measure_of_success": {
            "type": "string"
          },
          "review_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "interpretive_appendix": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "lane": {
          "const": "interpretive_only"
        },
        "system": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "interpretation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reflection_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disclaimer": {
          "type": "string"
        }
      },
      "required": [
        "lane",
        "system",
        "inputs",
        "interpretation",
        "reflection_questions",
        "disclaimer"
      ],
      "additionalProperties": false
    },
    "separation_policy": {
      "type": "object",
      "required": [
        "empirical_claims_exclude_interpretive_evidence",
        "interpretive_appendix_non_predictive"
      ],
      "properties": {
        "empirical_claims_exclude_interpretive_evidence": {
          "const": true
        },
        "interpretive_appendix_non_predictive": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "assessment_synthesis": {
      "$ref": "cross-assessment-synthesis.schema.json"
    }
  }
}
