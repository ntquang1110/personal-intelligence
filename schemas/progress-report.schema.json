{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Progress Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "period",
    "observations",
    "hypothesis_updates",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "report_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypothesis_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "status",
          "rationale"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "contradicted",
              "unresolved",
              "not_retested"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "baseline_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "baseline",
          "current",
          "comparability"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "baseline": {},
          "current": {},
          "comparability": {
            "enum": [
              "comparable",
              "partially_comparable",
              "not_comparable"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "measure"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "measure": {
            "type": "string"
          },
          "review_date": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
